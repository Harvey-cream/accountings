# 复制为 .env 后填写真实值（.env 已被 git 忽略，不会提交到仓库）
# cp .env.example .env

# Django：本地 debug，服务器 production
DJANGO_ENV=debug

# 福娃鸭 LLM（OpenAI 兼容接口）
LLM_AGENT_BASE_URL=https://gpt-agent.cc/v1
LLM_AGENT_API_KEY=
LLM_AGENT_MODEL=gpt-5.4

# 知识库向量（阿里云 DashScope）
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# 可选：知识库向量持久化目录（默认 account/ai/knowledge/chroma_db，服务器建议挂卷）
# KNOWLEDGE_CHROMA_DIR=
