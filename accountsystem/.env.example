# 复制为 .env 后填写真实值（.env 已被 git 忽略，不会提交到仓库）
# cp .env.example .env

# Django：本地 debug，服务器 production
DJANGO_ENV=debug

# 福娃鸭 LLM（OpenAI 兼容接口）
LLM_AGENT_BASE_URL=https://gpt-agent.cc/v1
LLM_AGENT_API_KEY=
LLM_AGENT_MODEL=gpt-5.4

# 知识库向量（阿里云 DashScope）
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# 可选：向量库持久化目录（服务器建议挂卷，如 /data/chroma）
# CHROMA_PERSIST_DIR=

# 可选：embedding 环境 local | production
# EMBEDDING_RUNTIME=

# 可选：改用本地 Ollama 时设 EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=auto
# LOCAL_EMBEDDING_MODEL=bge-m3
# LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
