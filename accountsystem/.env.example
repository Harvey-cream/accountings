# 复制为 .env 后填写真实值（.env 已被 git 忽略，不会提交到仓库）
# cp .env.example .env

# Django：本地 debug，服务器 production
DJANGO_ENV=debug

# Django 密钥：生产必须设置强随机值（勿用 django-insecure- 开头的自动生成值）
# 生成：python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# MySQL root 口令：docker-compose 必填（compose 用它初始化容器，并注入应用连接）
# 本地 debug 走 config/settings_debug.yaml，可留空；服务器务必用强随机值
MYSQL_ROOT_PASSWORD=

# 福娃鸭 LLM（OpenAI 兼容接口）
LLM_AGENT_BASE_URL=https://api4.mygptlife.com/v1/
LLM_AGENT_API_KEY=
LLM_AGENT_MODEL=claude-sonnet-4-6

# 候选模型（逗号分隔）：链 = 主模型 + 其余候选，按序兜底（与主模型重名的项自动跳过）
# 只改 LLM_AGENT_MODEL 即可整体换序；留空则用代码默认值
LLM_AGENT_FALLBACK_MODELS=claude-sonnet-4-6,gpt-5.6-luna,gemini-3.7-flash

# 分层模型（同一端点，仅模型名不同；不填则回退 LLM_AGENT_MODEL）
# 分类/路由/摘要等轻量任务用
LLM_MODEL_SIMPLE=claude-sonnet-4-6

# 阿里云 OSS（头像上传）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 知识库向量（阿里云 DashScope）
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v2

# 可选：知识库向量持久化目录（默认 account/ai/knowledge/chroma_db，服务器建议挂卷）
# KNOWLEDGE_CHROMA_DIR=
