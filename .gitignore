# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 数据库文件
*.sqlite3
*.db
*.sqlite

# IDE 配置
.idea/
*.iml
.vscode/

# Node 前端依赖（如果有）
node_modules/
package-lock.json
yarn.lock

# 环境变量/敏感配置
.env
.local
*.local

# 日志文件
*.log

# Django 迁移文件
# 忽略所有迁移文件（0001_initial.py 等），但保留 __init__.py 以保证目录结构存在
**/migrations/*.py
!**/migrations/__init__.py
**/migrations/__pycache__/